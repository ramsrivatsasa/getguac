<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- REQUIRED for Supabase / HTTP calls. Default Flutter scaffold only
         declares this in debug + profile manifests, so release APKs ship
         with NO network permission and DNS lookups fail. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Biometric (local_auth) permissions -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Location: used only when the user shares a destination from Google Maps,
         to reverse-geocode their current spot into a "From" address and compute
         driving miles. No background tracking. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- REQUEST_INSTALL_PACKAGES intentionally NOT declared: Google Play
         prohibits apps that update themselves by installing APKs, and flags
         the permission as undeclared/sensitive. The /download sideload build's
         in-app updater degrades gracefully (opens the APK so the user installs
         it manually); the Play build disables the updater entirely via the
         IS_PLAY dart-define (see UpdateService). -->
    <!-- Photo use is one-off (snap/pick a single receipt image), so per Google
         Play's photo and video permissions policy we must NOT request broad
         media access and instead use the system photo picker. image_picker
         falls back to the Android Photo Picker (Android 13+) when these aren't
         declared; Android 12 and below still use READ_EXTERNAL_STORAGE
         (maxSdkVersion=32). Strip the media permissions image_picker's library
         manifest merges in. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />

    <application
        android:label="GetGuac"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Share intent: receive text/URLs from other apps (Google Maps
                 → Share → GetGuac). Lets users log a trip with one tap from
                 a Maps destination. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>
        <!-- ML Kit Document Scanner — pre-fetch the docscanner module from
             Play Services at install time so the first scan doesn't crash
             with NPE when the module isn't loaded yet. Required because the
             plugin (google_mlkit_document_scanner 0.4.1) doesn't wrap the
             sync NPE from getStartScanIntent() — it propagates as a raw
             PlatformException with no helpful message. Pre-fetching avoids
             the cold-start gap entirely for Play Store users; sideloaded
             users still depend on Play Services downloading the module on
             first launch, but the manifest hint helps Play Services
             prioritise it. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="docscanner" />

        <!-- AdMob application id (GetGuac Android app, AdMob console). REQUIRED
             for the Mobile Ads SDK to start. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-5959691671441705~9900170190" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
