{
  "$comment": "GuacScore engine fixtures. Inputs: receipts list + optional bankBite. Output: { score, ratedCount, bankPenalty }. See web/src/lib/guacoscore.js + mobile/lib/screens/guacscore/guacscore_screen.dart::_calc.",
  "cases": [
    {
      "name": "no_rated_purchases_null",
      "input": { "receipts": [], "bankBite": null },
      "expected": { "score": null, "ratedCount": 0, "bankPenalty": 0 }
    },
    {
      "name": "single_five_star_low_value",
      "input": {
        "receipts": [{ "rating": 5, "totalAmount": 10 }],
        "bankBite": null
      },
      "expected": { "score": 100, "ratedCount": 1, "bankPenalty": 0 }
    },
    {
      "name": "single_one_star_low_value",
      "input": {
        "receipts": [{ "rating": 1, "totalAmount": 10 }],
        "bankBite": null
      },
      "expected": { "score": 0, "ratedCount": 1, "bankPenalty": 0 }
    },
    {
      "name": "single_three_star_neutral",
      "input": {
        "receipts": [{ "rating": 3, "totalAmount": 100 }],
        "bankBite": null
      },
      "expected": { "score": 50, "ratedCount": 1, "bankPenalty": 0 }
    },
    {
      "name": "mixed_ratings_weighted_average",
      "$comment": "(5-3)*25*100 + (1-3)*25*100 = 5000 + -5000 = 0, weight 200 → raw 50",
      "input": {
        "receipts": [
          { "rating": 5, "totalAmount": 100 },
          { "rating": 1, "totalAmount": 100 }
        ],
        "bankBite": null
      },
      "expected": { "score": 50, "ratedCount": 2, "bankPenalty": 0 }
    },
    {
      "name": "high_value_5star_outweighs_low_value_1star",
      "$comment": "(5-3)*25*1000 + (1-3)*25*10 = 50000 + -500 = 49500, weight 1010 → raw 50+49.0 ≈ 99",
      "input": {
        "receipts": [
          { "rating": 5, "totalAmount": 1000 },
          { "rating": 1, "totalAmount": 10 }
        ],
        "bankBite": null
      },
      "expected": { "score": 99, "ratedCount": 2, "bankPenalty": 0 }
    },
    {
      "name": "unrated_receipts_ignored",
      "input": {
        "receipts": [
          { "rating": 5, "totalAmount": 50 },
          { "rating": null, "totalAmount": 999999 }
        ],
        "bankBite": null
      },
      "expected": { "score": 100, "ratedCount": 1, "bankPenalty": 0 }
    },
    {
      "name": "zero_amount_skipped",
      "input": {
        "receipts": [
          { "rating": 5, "totalAmount": 0 },
          { "rating": 3, "totalAmount": 100 }
        ],
        "bankBite": null
      },
      "expected": { "score": 50, "ratedCount": 1, "bankPenalty": 0 }
    },
    {
      "name": "bank_bite_no_spending",
      "input": {
        "receipts": [],
        "bankBite": { "interest": 100, "fees": 50, "total": 150 }
      },
      "expected": { "score": null, "ratedCount": 0, "bankPenalty": 0 }
    },
    {
      "name": "bank_bite_small_relative_to_spend",
      "$comment": "$10 interest on $1000 spend, 5-star: raw 100. Penalty: ratioHit=(10/1000)*100=1, dollarHit=10/25+0=0.4, round(1.4)=1, score 99",
      "input": {
        "receipts": [{ "rating": 5, "totalAmount": 1000 }],
        "bankBite": { "interest": 10, "fees": 0, "total": 10 }
      },
      "expected": { "score": 99, "ratedCount": 1, "bankPenalty": 1 }
    },
    {
      "name": "bank_bite_huge_relative_to_spend_capped",
      "$comment": "$500 bite on $100 spend, 5-star: raw 100. Penalty: ratio 5.0, ratioHit capped at 25, dollarHit=500/25=20, round(45)=45, clamp at 25",
      "input": {
        "receipts": [{ "rating": 5, "totalAmount": 100 }],
        "bankBite": { "interest": 500, "fees": 0, "total": 500 }
      },
      "expected": { "score": 75, "ratedCount": 1, "bankPenalty": 25 }
    },
    {
      "name": "interest_hurts_more_than_fees_per_dollar",
      "$comment": "$100 interest vs $100 fees on same spend: interest hits harder via dollarHit (100/25=4 vs 100/50=2)",
      "input": {
        "receipts": [{ "rating": 5, "totalAmount": 1000 }],
        "bankBite": { "interest": 100, "fees": 0, "total": 100 }
      },
      "expected": { "score": 86, "ratedCount": 1, "bankPenalty": 14 }
    },
    {
      "name": "fees_only_lighter_penalty",
      "input": {
        "receipts": [{ "rating": 5, "totalAmount": 1000 }],
        "bankBite": { "interest": 0, "fees": 100, "total": 100 }
      },
      "expected": { "score": 88, "ratedCount": 1, "bankPenalty": 12 }
    },
    {
      "name": "negative_amount_absolute_value",
      "$comment": "Refund row with rating: amount.abs() is the weight, not signed amount",
      "input": {
        "receipts": [{ "rating": 5, "totalAmount": -50 }],
        "bankBite": null
      },
      "expected": { "score": null, "ratedCount": 0, "bankPenalty": 0 }
    },
    {
      "name": "many_neutral_ratings",
      "$comment": "10 receipts all 3-star → score 50 (every contribution is zero)",
      "input": {
        "receipts": [
          { "rating": 3, "totalAmount": 50 },
          { "rating": 3, "totalAmount": 75 },
          { "rating": 3, "totalAmount": 100 },
          { "rating": 3, "totalAmount": 125 },
          { "rating": 3, "totalAmount": 150 }
        ],
        "bankBite": null
      },
      "expected": { "score": 50, "ratedCount": 5, "bankPenalty": 0 }
    },
    {
      "name": "all_five_stars",
      "input": {
        "receipts": [
          { "rating": 5, "totalAmount": 100 },
          { "rating": 5, "totalAmount": 200 },
          { "rating": 5, "totalAmount": 300 }
        ],
        "bankBite": null
      },
      "expected": { "score": 100, "ratedCount": 3, "bankPenalty": 0 }
    },
    {
      "name": "all_one_stars_huge_regret",
      "input": {
        "receipts": [
          { "rating": 1, "totalAmount": 100 },
          { "rating": 1, "totalAmount": 200 }
        ],
        "bankBite": null
      },
      "expected": { "score": 0, "ratedCount": 2, "bankPenalty": 0 }
    }
  ]
}
