# Release signing for Play uploads. Copy to android/key.properties (which is
# gitignored) and fill in your real values. WITHOUT this file, release builds
# fall back to debug signing (fine for /download sideload, NOT accepted by Play).
#
# 1) Generate the upload keystore once (keep it forever — losing it means you
#    can never update the app on Play):
#      keytool -genkey -v -keystore getguac-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# 2) Put getguac-upload.jks in android/app/ (storeFile is resolved from the
#    app module, so use the bare filename; an absolute path also works).
# 3) Then: flutter build appbundle --release
#      -> build/app/outputs/bundle/release/app-release.aab  (upload this to Play)

storeFile=getguac-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
