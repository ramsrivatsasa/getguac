# GetGuac web — environment variables. Copy to .env.local for local dev;
# Vercel reads them from the dashboard. Anything missing should cause the
# corresponding feature to no-op rather than crash.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (crash + error reporting). Leave blank to disable entirely.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: required only to upload source maps at build time. Without it
# the build succeeds and Sentry still works at runtime; stack traces just
# stay minified.
SENTRY_AUTH_TOKEN=

# PostHog (behavioral analytics). Leave NEXT_PUBLIC_POSTHOG_KEY blank to
# disable. Host defaults to US cloud when unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Comma-separated IPs whose traffic is not counted in the first-party analytics
# (api/visit). Compared in memory and discarded — never stored, never logged.
# Use it to keep your own visits out of the numbers on a low-traffic site.
# NO NEXT_PUBLIC_ prefix: this must not ship to the browser.
ANALYTICS_IGNORE_IPS=
