node_modules/
.next/
out/
build/
dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Secrets ──────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ── Flutter (mobile/) ────────────────────────────────────────────────────
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/.idea/
mobile/.vscode/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/key.properties
mobile/android/app/release/
mobile/android/.kotlin/
mobile/android/app/build/
mobile/android/build/
mobile/**/*.iml
mobile/**/GeneratedPluginRegistrant.*

# ── IDE / editor ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS clutter ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Vercel ───────────────────────────────────────────────────────────────
.vercel
.turbo

# ── Test / coverage ──────────────────────────────────────────────────────
coverage/
*.lcov

# ── TypeScript build info ────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Optional: bundle outputs ─────────────────────────────────────────────
*.tgz
.yarn-integrity

# ── Memory directory used by Claude Code ─────────────────────────────────
.claude/
memory/

# ── Supabase local (if you use the CLI later) ────────────────────────────
.supabase/
supabase/.branches/
supabase/.temp/

.git-commit-msg.tmp
.backup_pre_centralization/

# ── Test bundle (large binaries don't belong in git) ───────────────
test/*.apk

# ── Generated marketing assets (screenshots/video; regen via scripts) ─
web/marketing-assets/

.vercel

# Local capture output — regenerate via web/scripts/capture-mobile.mjs
mobile-screens/

# Stray output from a script that ran with an undefined output path
web/undefined/

# ── Scratch that must never be committed ─────────────────────────────────
# Alternate build outputs from parallel agent sessions. These reached ~1.2 GB
# across a dozen directories; `git add -A` would have swept them in.
web/.next-codex*/
web/src/.next/
# Throwaway probe scripts and screenshot dumps. The `_` prefix is the existing
# convention in this repo for "written to answer one question, not shipped".
web/_*
!web/_route-backups/
