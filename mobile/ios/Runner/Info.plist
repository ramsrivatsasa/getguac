<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Getguac</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>getguac</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Permission strings — required by iOS or App Store review will reject. -->
	<!-- Camera: receipt capture via image_picker. -->
	<key>NSCameraUsageDescription</key>
	<string>GetGuac uses the camera to snap receipts so Guac-AI can read them.</string>

	<!-- Photo library read: "Choose from gallery" flow. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>GetGuac reads from your photos so you can pick an existing receipt image.</string>

	<!-- Photo library add: not strictly required today, kept for future
	     "save receipt as image" features. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>GetGuac can save receipt photos back to your library on request.</string>

	<!-- Face ID: biometric unlock via local_auth. Touch ID uses a separate
	     prompt strings managed by the OS but Face ID requires this key. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock GetGuac with Face ID so you don't have to retype your password.</string>

	<!-- Location (when-in-use): Car Miles (geolocator) reads your location
	     once when you log a trip, to fill the "From" address. Never in the
	     background. Required or the app crashes on first location request. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>GetGuac reads your location only when you log a trip, to fill in your starting point. It never tracks you in the background.</string>

	<!-- Microphone + Speech recognition: the voice → receipt capture flow
	     (speech_to_text wraps SFSpeechRecognizer + the mic). BOTH keys are
	     required on iOS or the app crashes when voice capture starts. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>GetGuac uses the microphone so you can add a receipt or note by voice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>GetGuac transcribes your speech so you can add a receipt or note by voice.</string>

	<!-- Receive-sharing-intent: app must declare it accepts inbound shares
	     of images / PDFs / text (used by Car Miles maps-share + future
	     receipt-from-share). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image / PDF / Text</string>
			<!-- GetGuac is not the primary owner of these types (Photos/Files are),
			     so it handles them as an Alternate. Required by App Store validation. -->
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
				<string>com.adobe.pdf</string>
				<string>public.text</string>
				<string>public.url</string>
			</array>
		</dict>
	</array>

	<!-- Document-based-app configuration required by App Store validation (90737).
	     GetGuac imports shared files (receive_sharing_intent copies them into the
	     app) rather than editing them in place, so opening-in-place is NO. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>

	<!-- AdMob (native Tier-2 ads). REQUIRED for the Mobile Ads SDK to start.
	     Real GetGuac iOS app id under publisher ca-app-pub-5959691671441705. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-5959691671441705~2306457499</string>

	<!-- App Tracking Transparency: iOS 14.5+ shows this when we request the
	     tracking prompt (for personalized ads). Decline = non-personalized
	     ads still serve. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>GetGuac uses this to show more relevant ads. You can keep ads non-personalized — they'll still work.</string>

	<!-- Export compliance: GetGuac only uses HTTPS/TLS provided by the OS, which
	     is exempt. Declaring it here stops App Store Connect from holding every
	     build in "Missing Compliance" until the question is answered by hand. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- SKAdNetwork — Google's primary id. Paste the full AdMob list before
	     production for complete ad-attribution coverage. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
</dict>
</plist>
